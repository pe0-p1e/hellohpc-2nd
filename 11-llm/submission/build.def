Bootstrap: docker
From: quay.io/ascend/vllm-ascend:DeepSeekV4-flash-0731

%labels
    org.hellohpc.purpose "ascend-llm-inference"
    org.hellohpc.framework "vllm-ascend"
    org.hellohpc.variant "llm-serving-v0"

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1

%post
    set -eu
    # Keep the image self-contained. Model weights are mounted by the evaluator.
    rm -rf /root/.cache/pip /tmp/pip-* 2>/dev/null || true

%test
    set -eu
    command -v python3
    command -v vllm
    python3 - <<'PY'
import torch
import torch_npu
import vllm
print("torch", torch.__version__)
print("torch_npu", torch_npu.__version__)
print("vllm", vllm.__version__)
PY
